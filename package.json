{
  "name": "humanbody-anatomy",
  "version": "0.2.0",
  "private": true,
  "description": "An interactive, turning 3D human anatomy model: click any part of the body to learn what it is and how it works.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "fetch-data": "sh tools/fetch-bodyparts3d.sh data/bodyparts3d && sh tools/fetch-hra.sh data/hra",
    "model": "node tools/classify.ts data/bodyparts3d tools/manifest.json && node tools/build-model.ts data/bodyparts3d && node --max-old-space-size=8000 tools/build-model.ts data/bodyparts3d --female data/hra",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "easy-speech": "^2.4.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "isosurface": "^1.0.0",
    "meshoptimizer": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "yauzl": "^3.4.0"
  }
}
